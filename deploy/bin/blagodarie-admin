#!/usr/bin/env bash
set -euo pipefail

SRC=/home/vdrzd/projects/blagodarie
DST=/srv/blagodarie
MAINT_USER=vdrzd
MAINT_GROUP=doverabot-maint
SERVICE_USER=blagodarie
SERVICE_GROUP=blagodarie
BOT_SETTINGS_LOCAL="$DST/telegram-bot/settings_local.py"
RENTAL_STT_SERVICE=doverabot-rental-stt.service
RENTAL_STT_VENV="$DST/venv-rental-stt"
RENTAL_STT_REQUIREMENTS="$DST/pip-rental-stt.txt"
RENTAL_STT_ADAPTER="$DST/telegram-bot/rental_stt_adapter.py"
RENTAL_STT_TMP_DIR="$DST/telegram-bot/tmp/rental-stt"
RENTAL_LLM_EXTRACTOR_SERVICE=doverabot-rental-llm-extractor.service
RENTAL_LLM_EXTRACTOR_VENV="$DST/venv-rental-llm-extractor"
RENTAL_LLM_EXTRACTOR_REQUIREMENTS="$DST/pip-rental-llm-extractor.txt"
RENTAL_LLM_EXTRACTOR_ADAPTER="$DST/telegram-bot/rental_llm_extractor_adapter.py"
RENTAL_LLM_EXTRACTOR_ENV_FILE=/etc/default/doverabot-rental-llm-extractor
BOT_RUNTIME_SETTING_KEYS=(
  RENTAL_STT_URL
  RENTAL_STT_TOKEN
  RENTAL_STT_MODE
  RENTAL_STT_CONTRACT
  RENTAL_STT_LANGUAGE
  RENTAL_STT_TIMEOUT
  RENTAL_DEBUG_LOG_CONVERSATION
  RENTAL_DEBUG_LOG_TEXT_LIMIT
  RENTAL_LLM_EXTRACTOR_URL
  RENTAL_LLM_EXTRACTOR_TOKEN
  RENTAL_LLM_EXTRACTOR_CONTRACT
  RENTAL_LLM_EXTRACTOR_MODEL
  RENTAL_LLM_EXTRACTOR_TIMEOUT
)
LLM_EXTRACTOR_ENV_KEYS=(
  RENTAL_LLM_PROVIDER_URL
  RENTAL_LLM_PROVIDER_API_KEY
  RENTAL_LLM_PROVIDER_MODEL
  RENTAL_LLM_PROVIDER_TIMEOUT
  RENTAL_LLM_PROVIDER_MAX_TIMEOUT
  RENTAL_LLM_PROVIDER_TEMPERATURE
  RENTAL_LLM_PROVIDER_MAX_TOKENS
  RENTAL_LLM_EXTRACTOR_PORT
  RENTAL_LLM_EXTRACTOR_MAX_TEXT_CHARS
  RENTAL_LLM_EXTRACTOR_LOG_TEXT_LIMIT
)

NGINX_SITES_SRC="$SRC/deploy/nginx/sites-available"
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_SITE_FILES=(
  api.doverabot.ru
  default
  doverabot.ru
)

RSYNC_EXCLUDES=(
  --exclude '/.git/'
  --exclude '/.agents/'
  --exclude '/.codex/'
  --exclude '/graphify-out/'
  --exclude '/AGENTS.md'
  --exclude '/log.md'
  --exclude '/app/app/local_settings.py'
  --exclude '/app/app/__pycache__/'
  --exclude '/app/media/'
  --exclude '/scripts/graphify-code.sh'
  --exclude '/scripts/unblock-django-test-db.sh'
  --exclude '/audit/'
  --exclude '/telegram-bot/settings_local.py'
  --exclude '/telegram-bot/ENV/'
  --exclude '/telegram-bot/tmp/'
  --exclude '/telegram-bot-api/'
  --exclude '/venv-app/'
  --exclude '/venv-rental-stt/'
  --exclude '/venv-rental-llm-extractor/'
  --exclude '**/__pycache__/'
  --exclude '*.pyc'
  --exclude '*.pyo'
)

FIND_EXCLUDES=(
  "$DST/app/app/local_settings.py"
  "$DST/app/app/__pycache__"
  "$DST/app/app/__pycache__/*"
  "$DST/app/contact/__pycache__"
  "$DST/app/contact/__pycache__/*"
  "$DST/app/restthumbnails/__pycache__"
  "$DST/app/restthumbnails/__pycache__/*"
  "$DST/app/users/__pycache__"
  "$DST/app/users/__pycache__/*"
  "$DST/app/wote/__pycache__"
  "$DST/app/wote/__pycache__/*"
  "$DST/app/media"
  "$DST/app/media/*"
  "$DST/audit"
  "$DST/audit/*"
  "$DST/telegram-bot/settings_local.py"
  "$DST/telegram-bot/__pycache__"
  "$DST/telegram-bot/__pycache__/*"
  "$DST/telegram-bot/ENV"
  "$DST/telegram-bot/ENV/*"
  "$DST/telegram-bot/tmp"
  "$DST/telegram-bot/tmp/*"
  "$DST/telegram-bot-api"
  "$DST/telegram-bot-api/*"
  "$DST/venv-app"
  "$DST/venv-app/*"
  "$DST/venv-rental-stt"
  "$DST/venv-rental-stt/*"
  "$DST/venv-rental-llm-extractor"
  "$DST/venv-rental-llm-extractor/*"
)

find_prune_args() {
  local args=()
  local pattern
  for pattern in "${FIND_EXCLUDES[@]}"; do
    args+=( -path "$pattern" -o )
  done
  unset "args[$((${#args[@]} - 1))]"
  printf '%s\0' "${args[@]}"
}

require_workspace() {
  if [ ! -d "$SRC/.git" ]; then
    echo "Missing git workspace: $SRC" >&2
    exit 1
  fi
}

restore_protected_runtime() {
  local secret
  for secret in \
    "$DST/app/app/local_settings.py" \
    "$DST/telegram-bot/settings_local.py"; do
    if [ -e "$secret" ]; then
      chown "$SERVICE_USER:$SERVICE_GROUP" "$secret"
      chmod 0640 "$secret"
    fi
  done

  local runtime
  for runtime in \
    "$DST/app/media" \
    "$DST/app/contact/__pycache__" \
    "$DST/app/restthumbnails/__pycache__" \
    "$DST/app/app/__pycache__" \
    "$DST/app/users/__pycache__" \
    "$DST/app/wote/__pycache__" \
    "$DST/audit" \
    "$DST/telegram-bot/__pycache__" \
    "$DST/telegram-bot/ENV" \
    "$DST/telegram-bot/tmp" \
    "$DST/telegram-bot-api" \
    "$DST/venv-app" \
    "$DST/venv-rental-stt" \
    "$DST/venv-rental-llm-extractor"; do
    if [ -e "$runtime" ]; then
      chown -R "$SERVICE_USER:$SERVICE_GROUP" "$runtime"
    fi
  done
}

apply_source_permissions() {
  local args=()
  local raw=()
  local item
  while IFS= read -r -d '' item; do
    raw+=( "$item" )
  done < <(find_prune_args)

  find "$DST" \( "${raw[@]}" \) -prune -o -type l -exec chown -h "$MAINT_USER:$MAINT_GROUP" {} +
  find "$DST" \( "${raw[@]}" \) -prune -o ! -type l -exec chown "$MAINT_USER:$MAINT_GROUP" {} +
  find "$DST" \( "${raw[@]}" \) -prune -o -type d -exec chmod 2775 {} +
  find "$DST" \( "${raw[@]}" \) -prune -o -type f -exec chmod u+rw,g+rw,o+r {} +
  find "$DST" \( "${raw[@]}" \) -prune -o -type f -perm /111 -exec chmod a+x {} +
  restore_protected_runtime
}

sync_source() {
  require_workspace
  rsync -a --delete --delete-delay \
    --chown="$MAINT_USER:$MAINT_GROUP" \
    "${RSYNC_EXCLUDES[@]}" \
    "$SRC/" "$DST/"
  apply_source_permissions
}

deploy_dry_run() {
  require_workspace
  rsync -ani --delete --delete-delay \
    "${RSYNC_EXCLUDES[@]}" \
    "$SRC/" "$DST/"
}

check_django() {
  cd "$DST/app"
  "$DST/venv-app/bin/python" manage.py check --deploy
}

install_nginx_sites() {
  require_workspace

  local site
  local src_site
  local available_site
  local enabled_site
  for site in "${NGINX_SITE_FILES[@]}"; do
    src_site="$NGINX_SITES_SRC/$site"
    if [ ! -f "$src_site" ]; then
      echo "Missing tracked nginx site config: $src_site" >&2
      exit 1
    fi
  done

  for site in "${NGINX_SITE_FILES[@]}"; do
    src_site="$NGINX_SITES_SRC/$site"
    available_site="$NGINX_SITES_AVAILABLE/$site"
    enabled_site="$NGINX_SITES_ENABLED/$site"

    install -o root -g root -m 0644 "$src_site" "$available_site"
    if [ -L "$enabled_site" ]; then
      ln -sfn "$available_site" "$enabled_site"
    elif [ -e "$enabled_site" ]; then
      echo "Refusing to replace non-symlink nginx enabled site: $enabled_site" >&2
      exit 1
    else
      ln -s "$available_site" "$enabled_site"
    fi
  done

  nginx -t
  systemctl reload nginx
}

write_rental_stt_service() {
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 2770 "$RENTAL_STT_TMP_DIR"

  cat > "/etc/systemd/system/$RENTAL_STT_SERVICE" <<UNIT
[Unit]
Description=Doverabot rental STT adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$SERVICE_USER
Group=$SERVICE_GROUP
WorkingDirectory=$DST
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=$DST/telegram-bot/tmp/huggingface
Environment=XDG_CACHE_HOME=$DST/telegram-bot/tmp/cache
Environment=RENTAL_STT_TMP_DIR=$RENTAL_STT_TMP_DIR
ExecStart=$RENTAL_STT_VENV/bin/python $RENTAL_STT_ADAPTER
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=$DST/telegram-bot/tmp

[Install]
WantedBy=multi-user.target
UNIT
}

install_rental_stt() {
  require_workspace
  sync_source

  if [ ! -f "$RENTAL_STT_REQUIREMENTS" ]; then
    echo "Missing rental STT requirements: $RENTAL_STT_REQUIREMENTS" >&2
    exit 1
  fi
  if [ ! -f "$RENTAL_STT_ADAPTER" ]; then
    echo "Missing rental STT adapter: $RENTAL_STT_ADAPTER" >&2
    exit 1
  fi

  if [ ! -x "$RENTAL_STT_VENV/bin/python" ]; then
    python3 -m venv "$RENTAL_STT_VENV"
  fi
  "$RENTAL_STT_VENV/bin/python" -m pip install --upgrade pip
  "$RENTAL_STT_VENV/bin/python" -m pip install -r "$RENTAL_STT_REQUIREMENTS"

  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 2770 "$DST/telegram-bot/tmp"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 2770 "$DST/telegram-bot/tmp/cache"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 2770 "$DST/telegram-bot/tmp/huggingface"
  install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 2770 "$RENTAL_STT_TMP_DIR"
  chown -R "$SERVICE_USER:$SERVICE_GROUP" "$RENTAL_STT_VENV" "$DST/telegram-bot/tmp"

  write_rental_stt_service
  systemctl daemon-reload
  systemctl enable "$RENTAL_STT_SERVICE"
  systemctl restart "$RENTAL_STT_SERVICE"
  systemctl --no-pager --plain is-active "$RENTAL_STT_SERVICE"
}

deploy_rental_stt() {
  sync_source
  systemctl restart "$RENTAL_STT_SERVICE"
}

write_rental_llm_extractor_service() {
  if [ ! -f "$RENTAL_LLM_EXTRACTOR_ENV_FILE" ]; then
    install -o root -g "$SERVICE_GROUP" -m 0640 /dev/null "$RENTAL_LLM_EXTRACTOR_ENV_FILE"
  else
    chown root:"$SERVICE_GROUP" "$RENTAL_LLM_EXTRACTOR_ENV_FILE"
    chmod 0640 "$RENTAL_LLM_EXTRACTOR_ENV_FILE"
  fi

  cat > "/etc/systemd/system/$RENTAL_LLM_EXTRACTOR_SERVICE" <<UNIT
[Unit]
Description=Doverabot rental LLM extractor adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$SERVICE_USER
Group=$SERVICE_GROUP
WorkingDirectory=$DST
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-$RENTAL_LLM_EXTRACTOR_ENV_FILE
ExecStart=$RENTAL_LLM_EXTRACTOR_VENV/bin/python $RENTAL_LLM_EXTRACTOR_ADAPTER
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=$DST/telegram-bot/tmp

[Install]
WantedBy=multi-user.target
UNIT
}

install_rental_llm_extractor() {
  require_workspace
  sync_source

  if [ ! -f "$RENTAL_LLM_EXTRACTOR_REQUIREMENTS" ]; then
    echo "Missing rental LLM extractor requirements: $RENTAL_LLM_EXTRACTOR_REQUIREMENTS" >&2
    exit 1
  fi
  if [ ! -f "$RENTAL_LLM_EXTRACTOR_ADAPTER" ]; then
    echo "Missing rental LLM extractor adapter: $RENTAL_LLM_EXTRACTOR_ADAPTER" >&2
    exit 1
  fi

  if [ ! -x "$RENTAL_LLM_EXTRACTOR_VENV/bin/python" ]; then
    python3 -m venv "$RENTAL_LLM_EXTRACTOR_VENV"
  fi
  "$RENTAL_LLM_EXTRACTOR_VENV/bin/python" -m pip install --upgrade pip
  "$RENTAL_LLM_EXTRACTOR_VENV/bin/python" -m pip install -r "$RENTAL_LLM_EXTRACTOR_REQUIREMENTS"

  chown -R "$SERVICE_USER:$SERVICE_GROUP" "$RENTAL_LLM_EXTRACTOR_VENV"

  write_rental_llm_extractor_service
  systemctl daemon-reload
  systemctl enable "$RENTAL_LLM_EXTRACTOR_SERVICE"
  systemctl restart "$RENTAL_LLM_EXTRACTOR_SERVICE"
  systemctl --no-pager --plain is-active "$RENTAL_LLM_EXTRACTOR_SERVICE"
}

deploy_rental_llm_extractor() {
  sync_source
  systemctl restart "$RENTAL_LLM_EXTRACTOR_SERVICE"
}

is_allowed_bot_runtime_setting() {
  local key="$1"
  local allowed
  for allowed in "${BOT_RUNTIME_SETTING_KEYS[@]}"; do
    if [ "$key" = "$allowed" ]; then
      return 0
    fi
  done
  return 1
}

validate_bot_runtime_setting() {
  local key="$1"
  local value="$2"

  if [ -z "$value" ]; then
    echo "Refusing to set empty value for $key; use clear if this is intentional." >&2
    return 1
  fi

  case "$key" in
    RENTAL_STT_URL|RENTAL_LLM_EXTRACTOR_URL)
      case "$value" in
        http://*|https://*) ;;
        *)
          echo "$key must start with http:// or https://" >&2
          return 1
          ;;
      esac
      ;;
    RENTAL_STT_MODE)
      case "$value" in
        file_id|download) ;;
        *)
          echo "RENTAL_STT_MODE must be file_id or download" >&2
          return 1
          ;;
      esac
      ;;
    RENTAL_STT_CONTRACT|RENTAL_STT_LANGUAGE|RENTAL_LLM_EXTRACTOR_CONTRACT|RENTAL_LLM_EXTRACTOR_MODEL)
      case "$value" in
        *[!A-Za-z0-9_.:/-]*)
          echo "$key contains unsupported characters" >&2
          return 1
          ;;
      esac
      ;;
    RENTAL_DEBUG_LOG_CONVERSATION)
      case "$value" in
        true|false|True|False|1|0|yes|no|on|off) ;;
        *)
          echo "RENTAL_DEBUG_LOG_CONVERSATION must be true or false" >&2
          return 1
          ;;
      esac
      ;;
    RENTAL_DEBUG_LOG_TEXT_LIMIT|RENTAL_STT_TIMEOUT|RENTAL_LLM_EXTRACTOR_TIMEOUT)
      case "$value" in
        ''|*[!0-9]*)
          echo "$key must be a positive integer" >&2
          return 1
          ;;
        *)
          if [ "$value" -le 0 ]; then
            echo "$key must be a positive integer" >&2
            return 1
          fi
          ;;
      esac
      ;;
  esac
}

bot_runtime_setting_usage() {
  cat >&2 <<'USAGE'
Usage:
  sudo -n /usr/local/sbin/blagodarie-admin bot-runtime-setting status [KEY|all]
  sudo -n /usr/local/sbin/blagodarie-admin bot-runtime-setting set KEY VALUE
  sudo -n /usr/local/sbin/blagodarie-admin bot-runtime-setting clear KEY

Allowed keys:
  RENTAL_STT_URL
  RENTAL_STT_TOKEN
  RENTAL_STT_MODE
  RENTAL_STT_CONTRACT
  RENTAL_STT_LANGUAGE
  RENTAL_STT_TIMEOUT
  RENTAL_DEBUG_LOG_CONVERSATION
  RENTAL_DEBUG_LOG_TEXT_LIMIT
  RENTAL_LLM_EXTRACTOR_URL
  RENTAL_LLM_EXTRACTOR_TOKEN
  RENTAL_LLM_EXTRACTOR_CONTRACT
  RENTAL_LLM_EXTRACTOR_MODEL
  RENTAL_LLM_EXTRACTOR_TIMEOUT

Values are written to the live bot settings file and are never printed.
USAGE
}

bot_runtime_setting() {
  local action="${2:-}"
  local key="${3:-}"
  local value="${4:-}"

  if [ ! -f "$BOT_SETTINGS_LOCAL" ]; then
    echo "Missing live bot settings file: $BOT_SETTINGS_LOCAL" >&2
    exit 1
  fi

  case "$action" in
    status)
      if [ -z "$key" ]; then
        key=all
      fi
      if [ "$key" != "all" ] && ! is_allowed_bot_runtime_setting "$key"; then
        echo "Unsupported bot runtime setting: $key" >&2
        bot_runtime_setting_usage
        exit 2
      fi
      python3 - "$BOT_SETTINGS_LOCAL" status "$key" "${BOT_RUNTIME_SETTING_KEYS[@]}" <<'PY'
import ast
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
target = sys.argv[3]
keys = sys.argv[4:]
pattern = re.compile(r"^\s*(%s)\s*=" % "|".join(re.escape(key) for key in keys))
values = {}

for line in path.read_text(encoding="utf-8").splitlines():
    match = pattern.match(line)
    if not match:
        continue
    key = match.group(1)
    raw = line.split("=", 1)[1].strip()
    try:
        value = ast.literal_eval(raw)
    except (SyntaxError, ValueError):
        value = raw
    values[key] = value

for key in keys:
    if target != "all" and key != target:
        continue
    if key not in values:
        status = "missing"
    elif values[key] in ("", None):
        status = "empty"
    else:
        status = "set"
    print(f"{key}={status}")
PY
      ;;
    set)
      if [ $# -ne 4 ] || ! is_allowed_bot_runtime_setting "$key"; then
        bot_runtime_setting_usage
        exit 2
      fi
      validate_bot_runtime_setting "$key" "$value"
      python3 - "$BOT_SETTINGS_LOCAL" set "$key" "$value" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[3]
value = sys.argv[4]
pattern = re.compile(r"^(\s*)%s\s*=" % re.escape(key))
lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
updated = []
replaced = False

if key == "RENTAL_DEBUG_LOG_CONVERSATION":
    rendered_value = "True" if value.lower() in {"true", "1", "yes", "on"} else "False"
elif key in {"RENTAL_DEBUG_LOG_TEXT_LIMIT", "RENTAL_STT_TIMEOUT", "RENTAL_LLM_EXTRACTOR_TIMEOUT"}:
    rendered_value = str(int(value))
else:
    rendered_value = repr(value)

for line in lines:
    if pattern.match(line):
        updated.append(f"{key} = {rendered_value}\n")
        replaced = True
    else:
        updated.append(line)

if not replaced:
    if updated and updated[-1].strip():
        updated.append("\n")
    updated.append(f"{key} = {rendered_value}\n")

path.write_text("".join(updated), encoding="utf-8")
PY
      restore_protected_runtime
      echo "$key=set"
      ;;
    clear)
      if [ $# -ne 3 ] || ! is_allowed_bot_runtime_setting "$key"; then
        bot_runtime_setting_usage
        exit 2
      fi
      python3 - "$BOT_SETTINGS_LOCAL" set "$key" "" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[3]
value = sys.argv[4]
pattern = re.compile(r"^(\s*)%s\s*=" % re.escape(key))
lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
updated = []
replaced = False

for line in lines:
    if pattern.match(line):
        updated.append(f"{key} = {value!r}\n")
        replaced = True
    else:
        updated.append(line)

if not replaced:
    if updated and updated[-1].strip():
        updated.append("\n")
    updated.append(f"{key} = {value!r}\n")

path.write_text("".join(updated), encoding="utf-8")
PY
      restore_protected_runtime
      echo "$key=empty"
      ;;
    *)
      bot_runtime_setting_usage
      exit 2
      ;;
  esac
}

is_allowed_llm_extractor_env_setting() {
  local key="$1"
  local allowed
  for allowed in "${LLM_EXTRACTOR_ENV_KEYS[@]}"; do
    if [ "$key" = "$allowed" ]; then
      return 0
    fi
  done
  return 1
}

validate_llm_extractor_env_setting() {
  local key="$1"
  local value="$2"

  if [ -z "$value" ]; then
    echo "Refusing to set empty value for $key; use clear if this is intentional." >&2
    return 1
  fi

  python3 - "$key" "$value" <<'PY'
import re
import sys

key = sys.argv[1]
value = sys.argv[2]

if "\n" in value or "\r" in value:
    print(f"{key} contains unsupported newline", file=sys.stderr)
    raise SystemExit(1)

if key == "RENTAL_LLM_PROVIDER_URL":
    if not (value.startswith("http://") or value.startswith("https://")):
        print(f"{key} must start with http:// or https://", file=sys.stderr)
        raise SystemExit(1)
elif key == "RENTAL_LLM_PROVIDER_MODEL":
    if not re.fullmatch(r"[A-Za-z0-9_.:/@+\-]+", value):
        print(f"{key} contains unsupported characters", file=sys.stderr)
        raise SystemExit(1)
elif key in {"RENTAL_LLM_EXTRACTOR_PORT", "RENTAL_LLM_PROVIDER_MAX_TOKENS", "RENTAL_LLM_EXTRACTOR_MAX_TEXT_CHARS", "RENTAL_LLM_EXTRACTOR_LOG_TEXT_LIMIT"}:
    try:
        number = int(value)
    except ValueError:
        print(f"{key} must be a positive integer", file=sys.stderr)
        raise SystemExit(1)
    if number <= 0:
        print(f"{key} must be a positive integer", file=sys.stderr)
        raise SystemExit(1)
    if key == "RENTAL_LLM_EXTRACTOR_PORT" and number > 65535:
        print(f"{key} must be between 1 and 65535", file=sys.stderr)
        raise SystemExit(1)
elif key in {"RENTAL_LLM_PROVIDER_TIMEOUT", "RENTAL_LLM_PROVIDER_MAX_TIMEOUT"}:
    try:
        number = float(value)
    except ValueError:
        print(f"{key} must be a positive number", file=sys.stderr)
        raise SystemExit(1)
    if number <= 0:
        print(f"{key} must be a positive number", file=sys.stderr)
        raise SystemExit(1)
elif key == "RENTAL_LLM_PROVIDER_TEMPERATURE":
    try:
        number = float(value)
    except ValueError:
        print(f"{key} must be a non-negative number", file=sys.stderr)
        raise SystemExit(1)
    if number < 0:
        print(f"{key} must be a non-negative number", file=sys.stderr)
        raise SystemExit(1)
PY
}

rental_llm_env_usage() {
  cat >&2 <<'USAGE'
Usage:
  sudo -n /usr/local/sbin/blagodarie-admin rental-llm-env status [KEY|all]
  sudo -n /usr/local/sbin/blagodarie-admin rental-llm-env set KEY VALUE
  sudo -n /usr/local/sbin/blagodarie-admin rental-llm-env clear KEY

Allowed keys for /etc/default/doverabot-rental-llm-extractor:
  RENTAL_LLM_PROVIDER_URL
  RENTAL_LLM_PROVIDER_API_KEY
  RENTAL_LLM_PROVIDER_MODEL
  RENTAL_LLM_PROVIDER_TIMEOUT
  RENTAL_LLM_PROVIDER_MAX_TIMEOUT
  RENTAL_LLM_PROVIDER_TEMPERATURE
  RENTAL_LLM_PROVIDER_MAX_TOKENS
  RENTAL_LLM_EXTRACTOR_PORT
  RENTAL_LLM_EXTRACTOR_MAX_TEXT_CHARS
  RENTAL_LLM_EXTRACTOR_LOG_TEXT_LIMIT

Values are written to the extractor EnvironmentFile and are never printed.
Secret values such as RENTAL_LLM_PROVIDER_API_KEY are reported only as redacted set/missing/empty status.
USAGE
}

ensure_rental_llm_env_file() {
  if [ ! -f "$RENTAL_LLM_EXTRACTOR_ENV_FILE" ]; then
    install -o root -g "$SERVICE_GROUP" -m 0640 /dev/null "$RENTAL_LLM_EXTRACTOR_ENV_FILE"
  else
    chown root:"$SERVICE_GROUP" "$RENTAL_LLM_EXTRACTOR_ENV_FILE"
    chmod 0640 "$RENTAL_LLM_EXTRACTOR_ENV_FILE"
  fi
}

rental_llm_env_setting() {
  local action="${2:-}"
  local key="${3:-}"
  local value="${4:-}"

  case "$action" in
    status)
      if [ -z "$key" ]; then
        key=all
      fi
      if [ "$key" != "all" ] && ! is_allowed_llm_extractor_env_setting "$key"; then
        echo "Unsupported rental LLM env setting: $key" >&2
        rental_llm_env_usage
        exit 2
      fi
      python3 - "$RENTAL_LLM_EXTRACTOR_ENV_FILE" status "$key" "${LLM_EXTRACTOR_ENV_KEYS[@]}" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
target = sys.argv[3]
keys = sys.argv[4:]
secret_markers = ("api_key", "authorization", "password", "secret", "token")
pattern = re.compile(r"^\s*(%s)\s*=" % "|".join(re.escape(key) for key in keys))
values = {}

if path.exists():
    for line in path.read_text(encoding="utf-8").splitlines():
        match = pattern.match(line)
        if not match:
            continue
        key = match.group(1)
        raw = line.split("=", 1)[1].strip()
        values[key] = raw

for key in keys:
    if target != "all" and key != target:
        continue
    if key not in values:
        status = "missing"
    elif values[key] in ("", "''", '""'):
        status = "empty"
    else:
        status = "set"
    suffix = " (redacted)" if status == "set" and any(marker in key.lower() for marker in secret_markers) else ""
    print(f"{key}={status}{suffix}")
PY
      ;;
    set)
      if [ $# -ne 4 ] || ! is_allowed_llm_extractor_env_setting "$key"; then
        rental_llm_env_usage
        exit 2
      fi
      validate_llm_extractor_env_setting "$key" "$value"
      ensure_rental_llm_env_file
      python3 - "$RENTAL_LLM_EXTRACTOR_ENV_FILE" "$key" "$value" <<'PY'
import re
import shlex
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]
value = sys.argv[3]
pattern = re.compile(r"^(\s*)%s\s*=" % re.escape(key))
lines = path.read_text(encoding="utf-8").splitlines(keepends=True) if path.exists() else []
updated = []
replaced = False
rendered_value = shlex.quote(value)

for line in lines:
    if pattern.match(line):
        updated.append(f"{key}={rendered_value}\n")
        replaced = True
    else:
        updated.append(line)

if not replaced:
    if updated and updated[-1].strip():
        updated.append("\n")
    updated.append(f"{key}={rendered_value}\n")

path.write_text("".join(updated), encoding="utf-8")
PY
      echo "$key=set"
      ;;
    clear)
      if [ $# -ne 3 ] || ! is_allowed_llm_extractor_env_setting "$key"; then
        rental_llm_env_usage
        exit 2
      fi
      ensure_rental_llm_env_file
      python3 - "$RENTAL_LLM_EXTRACTOR_ENV_FILE" "$key" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]
pattern = re.compile(r"^(\s*)%s\s*=" % re.escape(key))
lines = path.read_text(encoding="utf-8").splitlines(keepends=True) if path.exists() else []
updated = []
replaced = False

for line in lines:
    if pattern.match(line):
        updated.append(f"{key}=\n")
        replaced = True
    else:
        updated.append(line)

if not replaced:
    if updated and updated[-1].strip():
        updated.append("\n")
    updated.append(f"{key}=\n")

path.write_text("".join(updated), encoding="utf-8")
PY
      echo "$key=empty"
      ;;
    *)
      rental_llm_env_usage
      exit 2
      ;;
  esac
}

case "${1:-}" in
  deploy-dry-run)
    deploy_dry_run
    ;;
  sync)
    sync_source
    ;;
  deploy-static)
    sync_source
    nginx -t
    systemctl reload nginx
    ;;
  deploy-web)
    sync_source
    check_django
    systemctl restart blagodarie-gunicorn.service
    nginx -t
    systemctl reload nginx
    ;;
  deploy-bot)
    sync_source
    systemctl restart telegram-bot.service
    ;;
  deploy-rental-stt)
    deploy_rental_stt
    ;;
  deploy-rental-llm-extractor)
    deploy_rental_llm_extractor
    ;;
  deploy)
    sync_source
    check_django
    nginx -t
    systemctl reload nginx
    systemctl restart blagodarie-gunicorn.service
    systemctl restart telegram-bot.service
    ;;
  check-django)
    check_django
    ;;
  migrate)
    check_django
    cd "$DST/app"
    "$DST/venv-app/bin/python" manage.py migrate
    ;;
  collectstatic)
    cd "$DST/app"
    "$DST/venv-app/bin/python" manage.py collectstatic --noinput
    apply_source_permissions
    ;;
  install-nginx-sites)
    install_nginx_sites
    ;;
  install-rental-stt)
    install_rental_stt
    ;;
  install-rental-llm-extractor)
    install_rental_llm_extractor
    ;;
  nginx-test)
    nginx -t
    ;;
  reload-nginx)
    nginx -t
    systemctl reload nginx
    ;;
  restart-web)
    check_django
    systemctl restart blagodarie-gunicorn.service
    ;;
  restart-bot)
    systemctl restart telegram-bot.service
    ;;
  restart-rental-stt)
    systemctl restart "$RENTAL_STT_SERVICE"
    ;;
  restart-rental-llm-extractor)
    systemctl restart "$RENTAL_LLM_EXTRACTOR_SERVICE"
    ;;
  restart-all)
    check_django
    nginx -t
    systemctl reload nginx
    systemctl restart blagodarie-gunicorn.service
    systemctl restart telegram-bot.service
    ;;
  status)
    systemctl --no-pager --plain status nginx blagodarie-gunicorn.service telegram-bot.service "$RENTAL_STT_SERVICE"
    ;;
  is-active)
    systemctl --no-pager --plain is-active nginx blagodarie-gunicorn.service telegram-bot.service "$RENTAL_STT_SERVICE"
    ;;
  status-rental-stt)
    systemctl --no-pager --plain status "$RENTAL_STT_SERVICE"
    ;;
  status-rental-llm-extractor)
    systemctl --no-pager --plain status "$RENTAL_LLM_EXTRACTOR_SERVICE"
    ;;
  is-active-rental-llm-extractor)
    systemctl --no-pager --plain is-active "$RENTAL_LLM_EXTRACTOR_SERVICE"
    ;;
  logs-web)
    journalctl -u blagodarie-gunicorn.service -n "${2:-120}" --no-pager
    ;;
  logs-bot)
    journalctl -u telegram-bot.service -n "${2:-120}" --no-pager
    ;;
  logs-nginx)
    journalctl -u nginx.service -n "${2:-120}" --no-pager
    ;;
  logs-rental-stt)
    journalctl -u "$RENTAL_STT_SERVICE" -n "${2:-120}" --no-pager
    ;;
  logs-rental-llm-extractor)
    journalctl -u "$RENTAL_LLM_EXTRACTOR_SERVICE" -n "${2:-120}" --no-pager
    ;;
  bot-runtime-setting)
    bot_runtime_setting "$@"
    ;;
  rental-llm-env)
    rental_llm_env_setting "$@"
    ;;
  *)
    cat >&2 <<'USAGE'
Usage: sudo -n /usr/local/sbin/blagodarie-admin COMMAND

Commands:
  deploy-dry-run       Show live changes that deploy would make
  sync                 Sync workspace to /srv without restarting services
  deploy-static        Sync and reload nginx
  deploy-web           Sync, Django check, restart web, reload nginx
  deploy-bot           Sync and restart Telegram bot
  deploy-rental-stt    Sync and restart rental STT
  deploy-rental-llm-extractor
                       Sync and restart rental LLM extractor
  deploy               Sync, checks, reload nginx, restart web and bot
  check-django         Run manage.py check --deploy
  migrate              Run Django checks then migrations
  collectstatic        Run Django collectstatic
  install-nginx-sites  Install tracked nginx site configs, test, and reload nginx
  install-rental-stt   Install/update rental STT venv and systemd unit
  install-rental-llm-extractor
                       Install/update rental LLM extractor venv and systemd unit
  nginx-test           Validate nginx config
  reload-nginx         Validate and reload nginx
  restart-web          Django check and restart gunicorn
  restart-bot          Restart Telegram bot
  restart-rental-stt   Restart rental STT
  restart-rental-llm-extractor
                       Restart rental LLM extractor
  restart-all          Check/reload/restart nginx, web, and bot
  status               Show service status
  status-rental-stt    Show rental STT status
  status-rental-llm-extractor
                       Show rental LLM extractor status
  is-active            Print nginx/web/bot/rental STT active state
  is-active-rental-llm-extractor
                       Print rental LLM extractor active state
  logs-web [n]         Show recent web logs
  logs-bot [n]         Show recent bot logs
  logs-nginx [n]       Show recent nginx logs
  logs-rental-stt [n]  Show recent rental STT logs
  logs-rental-llm-extractor [n]
                       Show recent rental LLM extractor logs
  bot-runtime-setting  Check or set allowlisted live bot runtime settings
  rental-llm-env       Check or set allowlisted rental LLM adapter env settings
USAGE
    exit 2
    ;;
esac
