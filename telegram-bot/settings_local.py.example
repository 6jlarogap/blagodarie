import logging
from logging.handlers import RotatingFileHandler
LOG_CONFIG = dict(
    level = logging.INFO,

    handlers=[
        RotatingFileHandler(
            filename='/path/to/bot.log',
            maxBytes=10*1024*1024,
            backupCount=10,
    )],
    format='%(asctime)s %(levelname)s %(message)s',
    datefmt='%d.%m.%y %H:%M:%S',
)
